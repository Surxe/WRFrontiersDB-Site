---
import * as fs from 'fs';
import * as path from 'path';

const versionPath = path.join(
  process.cwd(),
  'WRFrontiersDB-Data/current/version.txt'
);

let gameVersion = 'Unknown';
if (fs.existsSync(versionPath)) {
  gameVersion = fs.readFileSync(versionPath, 'utf8').trim();
}
---

<footer class="site-footer">
  <span class="site-footer__version">
    Game version: <strong>{gameVersion}</strong>
  </span>
</footer>

<style>
  .site-footer {
    margin-top: 2rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid #444;
    background-color: #141414;
    text-align: center;
    font-size: 0.8rem;
    color: #888;
  }

  .site-footer__version strong {
    color: #aaa;
  }
</style>
