---
/**
 * UnifiedShoulderTable.astro
 * Renders a single HTML table for all shoulders across all profiles, showing
 * all stats from shoulder_profiles.json. One row per shoulder per level.
 * Rows are filtered by active profile via client-side JS.
 */
import type { LocalizationKey } from '../../types/localization';
import type { ModuleGroup } from '../../types/module_group';
import { resolveLocalizationKey } from '../../utils/localization';
import { refToId } from '../../utils/object_reference';
import LocalizedText from '../LocalizedText.astro';
import LocalizedStatValue from '../LocalizedStatValue.astro';
import LocalizedEmbed from '../LocalizedEmbed.astro';
import { getStatNameLocalizationKey } from '../../utils/stat_name_localization';
import { getStatMetadata } from '../../utils/stat';
import { getParseObjects } from '../../utils/parse_object';
import { resolveObjectRef } from '../../utils/object_resolver';

export interface Props {
  /** All shoulders across all profiles, with .profileId */
  shoulders: any[];
  /** Map from module ID to its localization key */
  moduleNameMap: Record<string, LocalizationKey>;
  shoulderGroup: ModuleGroup;
  /** Unique id for this table element */
  tableId: string;
}

const { shoulders, moduleNameMap, shoulderGroup, tableId } = Astro.props;

/** Ordered list of stat keys to display */
const STAT_COLUMNS = [
  'Armor',
  'ShieldAmount',
  'ShieldDelayReduction',
  'ShieldRegeneration',
  'RechargeDelay',
  'RechargeTime',
  'DelayAndRechargeTotal',
] as const;

/**
 * Build-time resolution of LocalizationKeys for each stat column.
 * getStatNameLocalizationKey follows the chain: Stat.id -> ModuleStat.stat_name,
 * falling back to SYNTHETIC_STAT_LOCALIZATION_MAP for parser-generated stats.
 */
const columnLocKeys = Object.fromEntries(
  STAT_COLUMNS.map((col) => [col, getStatNameLocalizationKey(col)])
) as Record<string, LocalizationKey | undefined>;

/** Hover descriptions for the question mark tooltips */
const COLUMN_DESCRIPTIONS: Record<string, string> = {
  Armor: 'The durability of the shoulder after shields are depleted.',
  ShieldAmount: 'The maximum capacity of the shield.',
  ShieldDelayReduction:
    'A multiplier reduction applied to the base shield recharge delay (10s).',
  ShieldRegeneration:
    'The amount of shield recovered per second once regeneration begins.',
  RechargeDelay:
    'The time in seconds after taking damage before shield regeneration begins.',
  RechargeTime:
    'The time in seconds it takes to fully regenerate the shield from 0 to maximum capacity.',
  DelayAndRechargeTotal:
    'The total time in seconds from taking damage until the shield is fully recharged (RechargeDelay + RechargeTime).',
};

const allStats = getParseObjects<any>('Objects/Stat.json');
const allModuleStats = getParseObjects<any>('Objects/ModuleStat.json');

/** Precompute metadata for formatting each stat column */
const columnMetadata = Object.fromEntries(
  STAT_COLUMNS.map((col) => {
    const statId = col;
    const statObj = allStats[statId];
    if (statObj && statObj.module_stat_ref) {
      const moduleStat = resolveObjectRef(
        statObj.module_stat_ref,
        allModuleStats
      );
      if (moduleStat) {
        return [
          col,
          {
            ...getStatMetadata(moduleStat),
            unitScaler: moduleStat.unit_scaler ?? 1,
          },
        ];
      }
    }
    // Fallback
    return [col, { pattern: '{Amount}{Unit}', shortKey: col, unitScaler: 1 }];
  })
);

/** Pattern key for rendering a stat label with its unit as "Name (unit)" */
const LABEL_PATTERN_KEY = resolveLocalizationKey(
  'ModuleStatPattern_Label',
  'Web_UI'
);
---

<div class="shoulder-stats-table-wrapper">
  <table id={tableId} class="shoulder-stats-table">
    <thead>
      <tr>
        <th>
          <LocalizedText tag="span" localizationKey={shoulderGroup.name} />
        </th>
        <th>Level</th>
        {
          STAT_COLUMNS.map((col) => {
            const meta = columnMetadata[col];
            const nameKey = columnLocKeys[col];
            return (
              <th>
                <div class="th-content">
                  {nameKey && meta.unitName ? (
                    <LocalizedEmbed
                      tag="span"
                      pattern={LABEL_PATTERN_KEY}
                      embeds={{
                        Label: nameKey,
                        Unit: meta.unitName as LocalizationKey,
                      }}
                    />
                  ) : nameKey ? (
                    <LocalizedText tag="span" localizationKey={nameKey} />
                  ) : (
                    <span>{col}</span>
                  )}
                  <div class="wrf-tooltip">
                    <span class="wrf-tooltip__icon">?</span>
                    <div class="wrf-tooltip__bubble">
                      {COLUMN_DESCRIPTIONS[col]}
                    </div>
                  </div>
                </div>
              </th>
            );
          })
        }
      </tr>
    </thead>
    <tbody>
      {
        shoulders.map((shoulder) => {
          const moduleId = refToId(shoulder.shoulder_module_ref);
          const moduleName = moduleNameMap[moduleId];
          const levelKeys = Object.keys(shoulder.levels).sort(
            (a, b) => parseInt(a) - parseInt(b)
          );

          return levelKeys.map((levelKey) => {
            const stats = shoulder.levels[levelKey];
            const levelNum = parseInt(levelKey);

            return (
              <tr
                data-level={levelNum}
                data-module-id={moduleId}
                data-profile-id={shoulder.profileId}
              >
                {/* Shoulder name cell — duplicated for every row so we can hide inactive levels easily */}
                <td class="shoulder-name-cell">
                  {moduleName?.InvariantString ? (
                    <span class="shoulder-table-name">
                      {moduleName.InvariantString}
                    </span>
                  ) : moduleName ? (
                    <span class="shoulder-table-name">
                      <LocalizedText tag="span" localizationKey={moduleName} />
                    </span>
                  ) : (
                    <span class="shoulder-table-name">{moduleId}</span>
                  )}
                </td>
                <td class="level-cell">{levelNum}</td>
                {STAT_COLUMNS.map((col) => {
                  const meta = columnMetadata[col];
                  const rawValue = stats[col];
                  const scaledValue =
                    rawValue !== undefined
                      ? rawValue * (meta.unitScaler as number)
                      : undefined;

                  return (
                    <td class="stat-cell">
                      <LocalizedStatValue
                        value={scaledValue}
                        pattern={meta.pattern as string}
                        unitName={meta.unitName as LocalizationKey | undefined}
                        unitExponent={meta.unitExponent as number | undefined}
                        decimalPlaces={meta.decimalPlaces as number | undefined}
                      />
                    </td>
                  );
                })}
              </tr>
            );
          });
        })
      }
    </tbody>
  </table>
</div>

<style>
  /* ---- ShoulderStatsTable ---- */
  .shoulder-stats-table-wrapper {
    border-radius: 6px;
    border: 1px solid var(--wrf-surface-2);
  }

  .shoulder-stats-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .shoulder-stats-table th:first-child {
    border-top-left-radius: 5px;
  }
  .shoulder-stats-table th:last-child {
    border-top-right-radius: 5px;
  }

  .shoulder-stats-table th {
    background: var(--wrf-surface);
    color: var(--wrf-text-muted);
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    text-align: right;
    font-weight: 600;
  }

  .shoulder-stats-table th:first-child,
  .shoulder-stats-table th:nth-child(2) {
    text-align: left;
  }

  .shoulder-stats-table td {
    padding: 0.4rem 0.75rem;
    border-top: 1px solid var(--wrf-surface);
    color: var(--wrf-text-muted);
    text-align: right;
  }

  .shoulder-stats-table .shoulder-name-cell {
    text-align: left;
    font-weight: 600;
    color: var(--wrf-text);
    background: var(--wrf-surface);
    border-right: 1px solid var(--wrf-surface-2);
    min-width: 110px;
    vertical-align: top;
  }

  .shoulder-stats-table .level-cell {
    text-align: center;
    color: var(--wrf-text-muted);
    min-width: 50px;
  }

  
  /* Hide all data rows by default.
    Uses :global so Astro does not append the component scope attributes,
    which would otherwise raise this rule's specificity above the :global
    show rule below and keep every row hidden. */
  :global(.shoulder-stats-table tr[data-level]) {
    display: none;
  }

  /* Only display the rows matching the currently selected level AND not hidden by legend toggle */
  :global(.shoulder-stats-table tr.is-active-level.is-legend-visible) {
    display: table-row;
  }

  /* ---- Tooltips ---- */
  :global(.th-content) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  /* Reset the first two columns to left-align */
  :global(.shoulder-stats-table th:first-child .th-content),
  :global(.shoulder-stats-table th:nth-child(2) .th-content) {
    justify-content: flex-start;
  }
</style>
