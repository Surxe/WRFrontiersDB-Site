---
/**
 * UnifiedShoulderTable.astro
 * Renders a single HTML table for all shoulders across all profiles, showing
 * all stats from shoulder_profiles.json. One row per shoulder per level.
 * Rows are filtered by active profile via client-side JS.
 */
import type { LocalizationKey } from '../../types/localization';
import { getDefaultString } from '../../utils/localization';
import { refToId } from '../../utils/object_reference';
import LocalizedText from '../LocalizedText.astro';

export interface Props {
  /** All shoulders across all profiles, with .profileId */
  shoulders: any[];
  /** Map from module ID to its localization key */
  moduleNameMap: Record<string, LocalizationKey>;
  /** Unique id for this table element */
  tableId: string;
}

const { shoulders, moduleNameMap, tableId } = Astro.props;

/** Ordered list of stat keys to display */
const STAT_COLUMNS = [
  'Armor',
  'ShieldAmount',
  'ShieldDelayReduction',
  'ShieldRegeneration',
  'RechargeDelay',
  'RechargeTime',
  'DelayAndRechargeTotal',
] as const;

/** Human-readable column headers (no localization required per spec) */
const COLUMN_LABELS: Record<string, string> = {
  Armor: 'Armor',
  ShieldAmount: 'Shield Amount',
  ShieldDelayReduction: 'Delay Reduction (%)',
  ShieldRegeneration: 'Shield Regen/s',
  RechargeDelay: 'Regen Delay (s)',
  RechargeTime: 'Fill Time (s)',
  DelayAndRechargeTotal: 'Full Recovery (s)',
};

/** Hover descriptions for the question mark tooltips */
const COLUMN_DESCRIPTIONS: Record<string, string> = {
  Armor: 'The durability of the shoulder after shields are depleted.',
  ShieldAmount: 'The maximum capacity of the shield.',
  ShieldDelayReduction:
    'A multiplier reduction applied to the base shield recharge delay (10s).',
  ShieldRegeneration:
    'The amount of shield recovered per second once regeneration begins.',
  RechargeDelay:
    'The time in seconds after taking damage before shield regeneration begins.',
  RechargeTime:
    'The time in seconds it takes to fully regenerate the shield from 0 to maximum capacity.',
  DelayAndRechargeTotal:
    'The total time in seconds from taking damage until the shield is fully recharged (RechargeDelay + RechargeTime).',
};

/** Columns whose raw values should be scaled before display */
const COLUMN_SCALE: Partial<Record<string, number>> = {
  ShieldDelayReduction: 100,
};

/** Format numbers: integers stay as integers; floats to 3 decimal places */
function fmt(value: number, col: string): string {
  const scale = COLUMN_SCALE[col] ?? 1;
  const scaled = value * scale;
  return Number.isInteger(scaled) ? scaled.toString() : scaled.toFixed(3);
}
---

<div class="shoulder-stats-table-wrapper">
  <table id={tableId} class="shoulder-stats-table">
    <thead>
      <tr>
        <th>Shoulder</th>
        <th>Level</th>
        {
          STAT_COLUMNS.map((col) => (
            <th>
              <div class="th-content">
                <span>{COLUMN_LABELS[col]}</span>
                <div class="stat-tooltip-container">
                  <span class="stat-help-icon">?</span>
                  <div class="stat-tooltip-text">
                    {COLUMN_DESCRIPTIONS[col]}
                  </div>
                </div>
              </div>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        shoulders.map((shoulder) => {
          const moduleId = refToId(shoulder.shoulder_module_ref);
          const moduleName = moduleNameMap[moduleId];
          const defaultName = moduleName
            ? (getDefaultString(moduleName) ?? moduleId)
            : moduleId;
          const levelKeys = Object.keys(shoulder.levels).sort(
            (a, b) => parseInt(a) - parseInt(b)
          );

          return levelKeys.map((levelKey) => {
            const stats = shoulder.levels[levelKey];
            const levelNum = parseInt(levelKey);

            return (
              <tr data-level={levelNum} data-module-id={moduleId} data-profile-id={shoulder.profileId}>
                {/* Shoulder name cell — duplicated for every row so we can hide inactive levels easily */}
                <td class="shoulder-name-cell">
                  {moduleName?.InvariantString ? (
                    <span class="shoulder-table-name">
                      {moduleName.InvariantString}
                    </span>
                  ) : moduleName ? (
                    <span class="shoulder-table-name">
                      <LocalizedText tag="span" localizationKey={moduleName} />
                    </span>
                  ) : (
                    <span class="shoulder-table-name">{moduleId}</span>
                  )}
                </td>
                <td class="level-cell">{levelNum}</td>
                {STAT_COLUMNS.map((col) => (
                  <td class="stat-cell">{fmt(stats[col], col)}</td>
                ))}
              </tr>
            );
          });
        })
      }
    </tbody>
  </table>
</div>

<style>
  /* ---- ShoulderStatsTable ---- */
  .shoulder-stats-table-wrapper {
    border-radius: 6px;
    border: 1px solid #383838;
  }

  .shoulder-stats-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .shoulder-stats-table th:first-child {
    border-top-left-radius: 5px;
  }
  .shoulder-stats-table th:last-child {
    border-top-right-radius: 5px;
  }

  .shoulder-stats-table th {
    background: #2e2e2e;
    color: #ccc;
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    text-align: right;
    font-weight: 600;
  }

  .shoulder-stats-table th:first-child,
  .shoulder-stats-table th:nth-child(2) {
    text-align: left;
  }

  .shoulder-stats-table td {
    padding: 0.4rem 0.75rem;
    border-top: 1px solid #2e2e2e;
    color: #ddd;
    text-align: right;
  }

  .shoulder-stats-table .shoulder-name-cell {
    text-align: left;
    font-weight: 600;
    color: #e8e8e8;
    background: #252525;
    border-right: 1px solid #383838;
    min-width: 110px;
    vertical-align: top;
  }

  .shoulder-stats-table .level-cell {
    text-align: center;
    color: #aaa;
    min-width: 50px;
  }

  /* Hide all data rows by default */
  .shoulder-stats-table tr[data-level] {
    display: none;
  }

  /* Only display the rows matching the currently selected level AND not hidden by legend toggle */
  .shoulder-stats-table tr.is-active-level.is-legend-visible {
    display: table-row;
  }

  /* ---- Tooltips ---- */
  :global(.th-content) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  /* Reset the first two columns to left-align */
  :global(.shoulder-stats-table th:first-child .th-content),
  :global(.shoulder-stats-table th:nth-child(2) .th-content) {
    justify-content: flex-start;
  }

  :global(.stat-tooltip-container) {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: help;
  }

  :global(.stat-help-icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: #4fc3f7;
    color: #121212;
    font-size: 10px;
    font-weight: bold;
    line-height: 1;
  }

  :global(.stat-tooltip-text) {
    visibility: hidden;
    opacity: 0;
    width: 220px;
    background-color: #333;
    color: #fff;
    text-align: left;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    position: absolute;
    z-index: 100;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
    transition:
      opacity 0.2s,
      visibility 0.2s;
    font-size: 0.8rem;
    font-weight: normal;
    white-space: normal;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    pointer-events: none;
  }

  :global(.stat-tooltip-text::after) {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -5px;
    border-width: 5px;
    border-style: solid;
    border-color: #333 transparent transparent transparent;
  }

  :global(.stat-tooltip-container:hover .stat-tooltip-text) {
    visibility: visible;
    opacity: 1;
  }
</style>
