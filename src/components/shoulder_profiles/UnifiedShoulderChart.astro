---
/**
 * UnifiedShoulderChart.astro
 * Renders a single shield recharge graph for all shoulders across profiles.
 * The active profile is controlled by client-side JS.
 */
import type { LocalizationKey } from '../../types/localization';
import { getDefaultString } from '../../utils/localization';
import { refToId } from '../../utils/object_reference';

export interface Props {
  /** Flattened shoulders array with .profileId injected */
  shoulders: any[];
  /** Map from module ID to localization key */
  moduleNameMap: Record<string, LocalizationKey>;
  /** Unique canvas id */
  graphId: string;
}

const {
  shoulders,
  moduleNameMap,
  graphId,
} = Astro.props;

// distinct colors for lines
const COLORS = [
  '#4fc3f7', // light blue
  '#f48fb1', // pink
  '#81c784', // green
  '#ffb74d', // orange
  '#ba68c8', // purple
  '#4db6ac', // teal
  '#e57373', // red
  '#aed581', // light green
];

// Serialize the data for JS
const chartData = shoulders.map((shoulder, idx) => {
  const moduleId = refToId(shoulder.shoulder_module_ref);
  return {
    id: moduleId,
    profileId: shoulder.profileId,
    color: COLORS[idx % COLORS.length],
    levels: shoulder.levels,
  };
});

const chartDataJson = JSON.stringify(chartData);
---

<div class="category-graph-card">
  <div class="chart-container">
    <canvas
      id={graphId}
      class="shield-chart-canvas"
      width="800"
      height="300"
      data-shoulders={chartDataJson}
      aria-label="Shield recharge chart for category"></canvas>
  </div>

  <div class="chart-legend">
    {
      shoulders.map((shoulder, idx) => {
        const moduleId = refToId(shoulder.shoulder_module_ref);
        const moduleName = moduleNameMap[moduleId] ?? {
          InvariantString: moduleId,
        };
        const defaultName = getDefaultString(moduleName) ?? moduleId;
        const color = COLORS[idx % COLORS.length];

        return (
          <div
            class="legend-item"
            role="button"
            tabindex="0"
            data-shoulder-id={moduleId}
            data-profile-id={shoulder.profileId}
            data-graph-id={graphId}
            aria-pressed="false"
            title="Click to hide/show this shoulder's line"
          >
            <span class="legend-color" style={`background-color: ${color};`} />
            {moduleName.InvariantString ? (
              <span class="legend-label">{moduleName.InvariantString}</span>
            ) : (
              <span
                class="legend-label"
                data-loc-key={moduleName.Key}
                data-loc-namespace={moduleName.TableNamespace}
              >
                {defaultName}
              </span>
            )}
          </div>
        );
      })
    }

    {/* Separator + armor toggle at the right end of the legend row */}
    <span class="legend-separator" aria-hidden="true" />
    <button
      class="armor-mode-toggle"
      data-graph-id={graphId}
      aria-pressed="false"
    >
      <span class="armor-toggle-icon" aria-hidden="true">⊕</span>
      Include Armor
      <div class="stat-tooltip-container" style="margin-left: 2px;">
        <span class="stat-help-icon">?</span>
        <div class="stat-tooltip-text" style="white-space: normal;">
          Use the stats from two of the same shoulder and add the shoulder's armor, showcasing their total health pool as opposed to just shields. Note that this is only a reasonable metric against single target weapons and weapons that deal equal damage to shields and armor.
        </div>
      </div>
    </button>
  </div>
</div>

<style>
  .category-graph-card {
    background: #242424;
    border: 1px solid #383838;
    border-radius: 8px;
    padding: 1.5rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .chart-container {
    width: 100%;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  .shield-chart-canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 0 auto;
  }

  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #333;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #e0e0e0;
    cursor: pointer;
    user-select: none;
    padding: 5px 12px 5px 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.04);
    transition:
      opacity 0.2s ease,
      background 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .legend-item:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.05);
  }

  .legend-item:active {
    background: rgba(255, 255, 255, 0.14);
    transform: scale(0.97);
  }

  .legend-item:focus-visible {
    outline: 2px solid #4fc3f7;
    outline-offset: 2px;
  }

  /* Disabled (hidden) state from user toggle */
  .legend-item.legend-item--disabled {
    opacity: 0.4;
    border-style: dashed;
    background: transparent;
  }

  .legend-item.legend-item--disabled .legend-label {
    text-decoration: line-through;
  }

  .legend-color {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    display: inline-block;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  /* ── Armor mode toggle ───────────────────────────────────── */
  .legend-separator {
    flex: 1 0 0;
    min-width: 0.5rem;
    border-left: 1px solid #444;
    align-self: stretch;
    margin: 2px 4px;
  }

  .armor-mode-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-family: inherit;
    color: #aaa;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 5px 12px 5px 8px;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .armor-mode-toggle:hover {
    color: #e0e0e0;
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.04);
  }

  .armor-mode-toggle:active {
    transform: scale(0.97);
  }

  .armor-mode-toggle:focus-visible {
    outline: 2px solid #81c784;
    outline-offset: 2px;
  }

  .armor-mode-toggle[aria-pressed='true'] {
    color: #81c784;
    background: rgba(129, 199, 132, 0.1);
    border-color: rgba(129, 199, 132, 0.35);
  }

  .armor-mode-toggle[aria-pressed='true']:hover {
    background: rgba(129, 199, 132, 0.18);
    border-color: rgba(129, 199, 132, 0.55);
    box-shadow: 0 0 0 3px rgba(129, 199, 132, 0.08);
  }

  .armor-toggle-icon {
    font-size: 1rem;
    line-height: 1;
  }
</style>
