---
/**
 * ShoulderStatsTable.astro
 * Renders a single HTML table for all shoulders in a category, showing
 * all stats from shoulder_profiles.json. One row per shoulder per level.
 *
 * Localization note: shoulder name headings use data-loc-* attributes so
 * the client-side localization JS can translate them. Stat column headers
 * are plain text (localization not required per spec).
 */
import type { LocalizationKey } from '../../types/localization';
import type { ShoulderEntry } from '../../types/shoulder_profile';
import { getDefaultString } from '../../utils/localization';
import { refToId } from '../../utils/object_reference';

export interface Props {
  /** All shoulders in this category */
  shoulders: ShoulderEntry[];
  /** Map from module ID to its localization key */
  moduleNameMap: Record<string, LocalizationKey>;
  /** Unique id for this table element */
  tableId: string;
}

const { shoulders, moduleNameMap, tableId } = Astro.props;

/** Ordered list of stat keys to display */
const STAT_COLUMNS = [
  'Armor',
  'ShieldAmount',
  'ShieldDelayReduction',
  'ShieldRegeneration',
  'RechargeDelay',
  'RechargeTime',
  'DelayAndRechargeTotal',
] as const;

/** Human-readable column headers (no localization required per spec) */
const COLUMN_LABELS: Record<string, string> = {
  Armor: 'Armor',
  ShieldAmount: 'Shield Amount',
  ShieldDelayReduction: 'Delay Reduction',
  ShieldRegeneration: 'Shield Regen/s',
  RechargeDelay: 'Recharge Delay (s)',
  RechargeTime: 'Recharge Time (s)',
  DelayAndRechargeTotal: 'Total Recharge (s)',
};

/** Format numbers: integers stay as integers; floats to 3 decimal places */
function fmt(value: number): string {
  return Number.isInteger(value) ? value.toString() : value.toFixed(3);
}
---

<div class="shoulder-stats-table-wrapper">
  <table id={tableId} class="shoulder-stats-table">
    <thead>
      <tr>
        <th>Shoulder</th>
        <th>Level</th>
        {STAT_COLUMNS.map((col) => <th>{COLUMN_LABELS[col]}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        shoulders.map((shoulder) => {
          const moduleId = refToId(shoulder.shoulder_module_ref);
          const moduleName = moduleNameMap[moduleId];
          const defaultName = moduleName ? (getDefaultString(moduleName) ?? moduleId) : moduleId;
          const levelKeys = Object.keys(shoulder.levels).sort(
            (a, b) => parseInt(a) - parseInt(b)
          );

          return levelKeys.map((levelKey, rowIdx) => {
            const stats = shoulder.levels[levelKey];
            const levelNum = parseInt(levelKey);
            const isFirstRow = rowIdx === 0;

            return (
              <tr data-level={levelNum} data-module-id={moduleId}>
                {/* Shoulder name cell — span all level rows for this shoulder */}
                {isFirstRow && (
                  <td rowspan={levelKeys.length} class="shoulder-name-cell">
                    {moduleName?.InvariantString ? (
                      <span class="shoulder-table-name">
                        {moduleName.InvariantString}
                      </span>
                    ) : moduleName ? (
                      <span
                        class="shoulder-table-name"
                        data-loc-key={moduleName.Key}
                        data-loc-namespace={moduleName.TableNamespace}
                      >
                        {defaultName}
                      </span>
                    ) : (
                      <span class="shoulder-table-name">{moduleId}</span>
                    )}
                  </td>
                )}
                <td class="level-cell">{levelNum}</td>
                {STAT_COLUMNS.map((col) => (
                  <td class="stat-cell">{fmt(stats[col])}</td>
                ))}
              </tr>
            );
          });
        })
      }
    </tbody>
  </table>
</div>
