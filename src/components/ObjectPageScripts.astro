---
export interface Props {
  objectData: any;
  jsFileName?: string;
  slug?: string;
}

const { objectData, jsFileName, slug } = Astro.props;

// Store complete object data with slug for browser access
const browserData = {
  ...objectData,
  slug: slug,
};
---

<!--Common astro scripts for all ParseObject pages--><!--Complete object data with slug, for browser-console access (see docs/browser-data-access.md).
    A data-* attribute, not <script type="application/json" set:text>: set:text
    HTML-escapes the JSON and the browser does not decode entities inside <script>.-->
<div id="browser-data" hidden data-json={JSON.stringify(browserData)}></div>

<!--Initialize localization on all the localizeable elements-->
<script type="module">
  const localizationModule = await import('/js/localization.js');
  const { initializeLocalization } = localizationModule;
  initializeLocalization('current');
</script>

<!--Load the specific JS file for this object page, only if jsFileName is provided-->{
  jsFileName && <script is:inline src={`/js/${jsFileName}`} />
}
