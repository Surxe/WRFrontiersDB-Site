---
import TalentDisplay from './TalentDisplay.astro';
import type { PilotTalent } from '../../types/pilot';
import type { StatValueChoices } from '../../types/stat';

interface Props {
  talent: PilotTalent;
  statValueChoices: StatValueChoices;
  fullOrOnHover?: 'full' | 'onHover';
  rowspan?: number;
  isHighlighted?: boolean;
}

const {
  talent,
  statValueChoices,
  fullOrOnHover = 'full',
  rowspan,
  isHighlighted = false,
} = Astro.props;
---

<td rowspan={rowspan} class={isHighlighted ? 'highlighted-talent' : ''}>
  <TalentDisplay
    talent={talent}
    statValueChoices={statValueChoices}
    fullOrOnHover={fullOrOnHover}
  />
</td>
