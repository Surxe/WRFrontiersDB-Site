---
import type { LocalizationKey } from '../types/localization';
import { getDefaultString } from '../utils/localization';

export interface Props {
  id?: string;
  tag: string;
  localizationKey: LocalizationKey;
  stripColorMarkup?: boolean;
}

const { id, tag, localizationKey, stripColorMarkup = false } = Astro.props;
const Tag = tag as any;

const namespace = localizationKey.TableNamespace;
const key = localizationKey.Key;
const hasLocalizableKey = !!(key && namespace);
const defaultText = getDefaultString(localizationKey);
---

<!--
Creates an html element with tag {tag}, e.g. <p> that stores localization data
necessary to localize it, as well as the default text while the localization lazy-loads

If a Key+TableNamespace exist, always create a localization element so client-side
localization can resolve the proper text for the current language. InvariantString is
only used as a static element when no Key+TableNamespace are present.
-->{
  hasLocalizableKey ? (
    <Tag
      id={id}
      data-loc-key={key}
      data-loc-namespace={namespace}
      data-strip-color-markup={stripColorMarkup}
    >
      {defaultText}
    </Tag>
  ) : (
    <Tag id={id}>{defaultText}</Tag>
  )
}
