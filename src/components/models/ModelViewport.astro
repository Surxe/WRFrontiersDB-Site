---
// The three.js render target + status line. src/scripts/model_viewer mounts the
// WebGL canvas into #model-canvas (render/viewer.ts; transparent, over this
// element's background) and writes progress into #model-status. In the 2D
// views it also overlays part labels there (render/label_overlay.ts, content
// from ui/view_labels.ts), hence the :global styles. The mesh / hitbox
// toggles float over the viewport's corner, outside #model-canvas (whose
// role="img" would hide them from assistive tech), as does the fullscreen
// button (ui/fullscreen.ts; hidden until the script wires it up). Fullscreen
// takes .model-viewport (class is-fullscreen), overlays and all.
import LocalizedText from '../LocalizedText.astro';
import { getDefaultString } from '../../utils/localization';
import type { ModelStrings } from '../../scripts/model_viewer/strings';

interface Props {
  strings: ModelStrings;
}

const { strings } = Astro.props;
---

<div id="model-viewport" class="model-viewport">
  <div
    id="model-canvas"
    class="model-canvas"
    role="img"
    aria-label={getDefaultString(strings.viewerLabel)}
    data-model-aria-label="viewerLabel"
  >
    <div id="model-loading" class="model-canvas-loading">
      <LocalizedText tag="span" localizationKey={strings.loadingViewer} />
    </div>
  </div>
  <div class="model-view-toggles">
    <label class="model-check">
      <input type="checkbox" id="model-mesh" checked />
      <LocalizedText tag="span" localizationKey={strings.mesh} />
    </label>
    <label class="model-check">
      <input type="checkbox" id="model-hitbox" checked />
      <LocalizedText tag="span" localizationKey={strings.hitbox} />
    </label>
  </div>
  <button
    type="button"
    id="model-fullscreen"
    class="model-fullscreen-btn"
    aria-label={getDefaultString(strings.fullscreenEnter)}
    title={getDefaultString(strings.fullscreenEnter)}
    hidden
  >
    <svg
      class="model-fullscreen-icon model-fullscreen-icon--enter"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"></path>
    </svg>
    <svg
      class="model-fullscreen-icon model-fullscreen-icon--exit"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5"></path>
    </svg>
  </button>
</div>
<p id="model-status" class="model-status" aria-live="polite">
  <LocalizedText tag="span" localizationKey={strings.statusLoading} />
</p>

<style>
  .model-viewport {
    position: relative;
  }

  /* Overlays keep clear of notches and rounded corners in fullscreen. */
  .model-viewport:global(.is-fullscreen) {
    --model-inset-top: calc(0.75rem + env(safe-area-inset-top, 0px));
    --model-inset-left: calc(0.75rem + env(safe-area-inset-left, 0px));
    --model-inset-right: calc(0.75rem + env(safe-area-inset-right, 0px));

    display: flex;
    flex-direction: column;
    background: var(--wrf-bg);
  }

  /* The CSS fallback (no Fullscreen API; ui/fullscreen.ts): cover the page.
     dvh tracks mobile browser chrome as it shows and hides. */
  .model-viewport:global(.is-pinned) {
    position: fixed;
    inset: 0;
    z-index: 1000;
    height: 100vh;
    height: 100dvh;
  }

  .model-viewport:global(.is-fullscreen) .model-canvas {
    flex: 1;
    min-height: 0;
    height: auto;
    border: none;
    border-radius: 0;
  }

  :global(html.model-fullscreen-lock),
  :global(html.model-fullscreen-lock body) {
    overflow: hidden;
  }

  .model-fullscreen-btn {
    position: absolute;
    top: var(--model-inset-top, 0.5rem);
    right: var(--model-inset-right, 0.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-sm);
    background: color-mix(in srgb, var(--wrf-bg) 72%, transparent);
    color: var(--wrf-text);
    cursor: pointer;
    transition:
      background var(--wrf-transition),
      border-color var(--wrf-transition),
      color var(--wrf-transition),
      transform 0.1s ease;
  }

  .model-fullscreen-btn[hidden] {
    display: none;
  }

  .model-fullscreen-btn:hover {
    border-color: var(--wrf-accent);
    color: var(--wrf-accent);
  }

  .model-fullscreen-btn:active {
    transform: scale(0.94);
  }

  .model-fullscreen-btn:focus-visible {
    outline: 2px solid var(--wrf-accent);
    outline-offset: 2px;
  }

  /* Touch: a full 44px target. */
  @media (pointer: coarse) {
    .model-fullscreen-btn {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .model-fullscreen-icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .model-fullscreen-icon--exit,
  :global(.is-fullscreen) .model-fullscreen-icon--enter {
    display: none;
  }

  :global(.is-fullscreen) .model-fullscreen-icon--exit {
    display: block;
  }

  .model-view-toggles {
    position: absolute;
    top: var(--model-inset-top, 0.5rem);
    left: var(--model-inset-left, 0.5rem);
    display: flex;
    gap: 0.75rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-sm);
    /* Translucent, like the view labels, so the robot shows through. */
    background: color-mix(in srgb, var(--wrf-bg) 72%, transparent);
  }

  .model-check {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
  }

  .model-canvas {
    position: relative;
    width: 100%;
    height: 640px;
    overflow: hidden;
    background: var(--wrf-bg);
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-md);
  }

  .model-canvas :global(canvas) {
    display: block;
  }

  .model-canvas-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--wrf-text-muted);
  }

  .model-status {
    min-height: 1.2em;
    margin: 0.5rem 0 0;
    color: var(--wrf-text-muted);
    font-size: 0.85rem;
  }

  /* 2D view labels (render/label_overlay.ts). */
  .model-canvas :global(.model-view-labels) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .model-canvas :global(.model-view-labels[hidden]),
  .model-canvas :global(.model-view-label[hidden]) {
    display: none;
  }

  .model-canvas :global(.model-view-labels svg) {
    position: absolute;
    inset: 0;
  }

  .model-canvas :global(.model-view-labels line) {
    stroke-width: 1;
    opacity: 0.7;
  }

  .model-canvas :global(.model-view-label) {
    position: absolute;
    max-width: 174px;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-sm);
    /* Translucent, so the robot shows through where a label overlaps it. */
    background: color-mix(in srgb, var(--wrf-bg) 72%, transparent);
    color: var(--wrf-text);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .model-canvas :global(.model-view-label-head) {
    display: flex;
    gap: 0.3rem;
    align-items: center;
    font-weight: bold;
  }

  .model-canvas :global(.model-view-label .model-swatch) {
    width: 0.65rem;
    height: 0.65rem;
  }

  .model-canvas :global(.model-view-label-part) {
    margin: 0.15rem 0;
    overflow-wrap: anywhere;
  }

  .model-canvas :global(.model-view-label-area) {
    font-variant-numeric: tabular-nums;
  }
</style>
