---
// The three.js render target + status line. src/scripts/model_viewer mounts the
// WebGL canvas into #model-canvas and writes progress into #model-status.
---

<div id="model-canvas" class="model-canvas" role="img" aria-label="3D model viewer">
  <div id="model-loading" class="model-canvas-loading">Loading viewer...</div>
</div>
<div id="model-status" class="model-status">Initializing...</div>

<style>
  .model-canvas {
    position: relative;
    width: 100%;
    height: 640px;
    border-radius: 8px;
    overflow: hidden;
    background: #14161a;
  }

  .model-canvas canvas {
    display: block;
  }

  .model-canvas-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9aa0a6;
  }

  .model-status {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #9aa0a6;
    min-height: 1.2em;
  }
</style>
