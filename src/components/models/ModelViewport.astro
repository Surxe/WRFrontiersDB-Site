---
// The /models viewer: the shared viewport chrome (../viewer/Viewport.astro:
// #model-canvas, #model-status, the fullscreen button) with the model
// viewer's controls over it. src/scripts/model_viewer mounts the WebGL canvas
// into #model-canvas (render/viewer.ts) and writes progress into
// #model-status. In the 2D views it also overlays part labels there
// (render/label_overlay.ts, content from ui/view_labels.ts), hence the
// :global(#model-canvas ...) styles. Controls (.viewer-overlay, which the 2D
// labels keep clear of): the mesh / hitbox toggles and the re-center button
// top-left, and along the bottom the camera mode (3D / flat 2D), the side
// buttons (none pressed at a custom 3D angle) and, while comparing in 3D, the
// compare layout (A and B overlapping or side by side; page.ts shows it,
// render/viewer.ts tags each build when apart). The re-center button stays
// hidden until the script wires it up.
import LocalizedText from '../LocalizedText.astro';
import Viewport from '../viewer/Viewport.astro';
import { getDefaultString } from '../../utils/localization';
import type { ModelStrings } from '../../scripts/model_viewer/strings';
import type { ViewName } from '../../scripts/robot/hitbox_area/views';
import type { CompareLayout } from '../../scripts/model_viewer/render/compare_layout';
import type { LocalizationKey } from '../../types/localization';

interface Props {
  strings: ModelStrings;
}

const { strings } = Astro.props;

const modes = [
  { mode: '3d', label: strings.mode3d, pressed: true },
  { mode: '2d', label: strings.mode2d, pressed: false },
];
const layouts: {
  layout: CompareLayout;
  label: LocalizationKey;
  pressed: boolean;
}[] = [
  { layout: 'overlap', label: strings.layoutOverlap, pressed: true },
  { layout: 'side', label: strings.layoutSide, pressed: false },
];
const views: { view: ViewName; label: LocalizationKey }[] = [
  { view: 'front', label: strings.viewFront },
  { view: 'back', label: strings.viewBack },
  { view: 'left', label: strings.viewLeft },
  { view: 'right', label: strings.viewRight },
  { view: 'top', label: strings.viewTop },
];
---

<Viewport
  id="model"
  label={strings.viewerLabel}
  labelAttrs={{ 'data-model-aria-label': 'viewerLabel' }}
  loading={strings.loadingViewer}
  status={strings.statusLoading}
  fullscreen={strings.fullscreenEnter}
>
  <div slot="start" class="viewer-overlay model-overlay-start">
    <div class="model-view-toggles">
      <label class="model-check">
        <input type="checkbox" id="model-mesh" checked />
        <LocalizedText tag="span" localizationKey={strings.mesh} />
      </label>
      <label class="model-check">
        <input type="checkbox" id="model-hitbox" checked />
        <LocalizedText tag="span" localizationKey={strings.hitbox} />
      </label>
    </div>
    <!-- Pans back to the robot's center, keeping the angle and zoom. -->
    <button
      type="button"
      id="model-recenter"
      class="viewer-icon-btn"
      aria-label={getDefaultString(strings.recenter)}
      title={getDefaultString(strings.recenter)}
      data-model-aria-label="recenter"
      data-model-title="recenter"
      hidden
    >
      <svg
        class="viewer-icon"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M12 2v4M12 18v4M2 12h4M18 12h4M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0"
        ></path>
      </svg>
    </button>
  </div>
  <!-- Flashed by ui/touch_hint.ts when one finger tries to orbit the inline
       viewer, where one finger scrolls the page. -->
  <p id="model-touch-hint" class="model-touch-hint" aria-hidden="true">
    <LocalizedText tag="span" localizationKey={strings.twoFingerHint} />
  </p>
  <div class="viewer-overlay model-camera-bar">
    <div
      id="model-mode-buttons"
      class="wrf-toggle wrf-toggle--sm"
      role="group"
      aria-label={getDefaultString(strings.cameraMode)}
      data-model-aria-label="cameraMode"
    >
      {
        modes.map(({ mode, label, pressed }) => (
          <button
            type="button"
            class="wrf-toggle__btn"
            data-mode={mode}
            aria-pressed={String(pressed)}
          >
            <LocalizedText tag="span" localizationKey={label} />
          </button>
        ))
      }
    </div>
    <div
      id="model-view-buttons"
      class="wrf-toggle wrf-toggle--sm"
      role="group"
      aria-label={getDefaultString(strings.cameraSide)}
      data-model-aria-label="cameraSide"
    >
      {
        views.map(({ view, label }) => (
          <button
            type="button"
            class="wrf-toggle__btn"
            data-view={view}
            aria-pressed="false"
          >
            <LocalizedText tag="span" localizationKey={label} />
          </button>
        ))
      }
    </div>
    <div
      id="model-layout-buttons"
      class="wrf-toggle wrf-toggle--sm"
      role="group"
      aria-label={getDefaultString(strings.compareLayout)}
      data-model-aria-label="compareLayout"
      hidden
    >
      {
        layouts.map(({ layout, label, pressed }) => (
          <button
            type="button"
            class="wrf-toggle__btn"
            data-layout={layout}
            aria-pressed={String(pressed)}
          >
            <LocalizedText tag="span" localizationKey={label} />
          </button>
        ))
      }
    </div>
  </div>
</Viewport>

<style>
  .model-overlay-start {
    position: absolute;
    top: var(--viewer-inset-top, 0.5rem);
    left: var(--viewer-inset-left, 0.5rem);
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
  }

  /* Centered along the bottom; wraps to two rows on narrow screens. Only the
     groups take pointer events, so the gaps still orbit the camera. */
  .model-camera-bar {
    position: absolute;
    right: var(--viewer-inset-right, 0.5rem);
    bottom: var(--viewer-inset-bottom, 0.5rem);
    left: var(--viewer-inset-left, 0.5rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    pointer-events: none;
  }

  .model-camera-bar .wrf-toggle {
    pointer-events: auto;
    background: color-mix(in srgb, var(--wrf-surface) 85%, transparent);
  }

  .model-camera-bar .wrf-toggle[hidden] {
    display: none;
  }

  .model-touch-hint {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-md);
    background: var(--wrf-overlay-bg);
    color: var(--wrf-text);
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity var(--wrf-transition);
  }

  .model-touch-hint:global(.is-shown) {
    opacity: 1;
  }

  .model-view-toggles {
    display: flex;
    gap: 0.75rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-sm);
    /* Translucent, like the view labels, so the robot shows through. */
    background: var(--wrf-overlay-bg);
  }

  .model-check {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
  }

  /* Build name tags over the 3D view while comparing side by side
     (render/build_tags.ts): each centered just above its build. */
  :global(#model-canvas .model-build-tags) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  :global(#model-canvas .model-build-tags[hidden]),
  :global(#model-canvas .model-build-tag[hidden]) {
    display: none;
  }

  :global(#model-canvas .model-build-tag) {
    position: absolute;
    display: flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-sm);
    background: var(--wrf-overlay-bg);
    color: var(--wrf-text);
    font-size: 0.8rem;
    font-weight: bold;
    white-space: nowrap;
    transform: translate(-50%, calc(-100% - 0.5rem));
  }

  /* 2D view labels (render/label_overlay.ts). */
  :global(#model-canvas .model-view-labels) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  :global(#model-canvas .model-view-labels[hidden]),
  :global(#model-canvas .model-view-label[hidden]) {
    display: none;
  }

  :global(#model-canvas .model-view-labels svg) {
    position: absolute;
    inset: 0;
  }

  :global(#model-canvas .model-view-labels line) {
    stroke-width: 1;
    opacity: 0.7;
  }

  :global(#model-canvas .model-view-label) {
    position: absolute;
    max-width: 174px;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-sm);
    /* Translucent, so the robot shows through where a label overlaps it. */
    background: var(--wrf-overlay-bg);
    color: var(--wrf-text);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  :global(#model-canvas .model-view-label-head) {
    display: flex;
    gap: 0.3rem;
    align-items: center;
    font-weight: bold;
  }

  :global(#model-canvas .model-view-label .model-swatch) {
    width: 0.65rem;
    height: 0.65rem;
  }

  :global(#model-canvas .model-view-label-part) {
    margin: 0.15rem 0;
    overflow-wrap: anywhere;
  }

  /* The narrow-canvas rows layout keeps cards short; the build panels name
     the parts. */
  :global(#model-canvas .model-view-labels.is-rows .model-view-label-part) {
    display: none;
  }

  :global(#model-canvas .model-view-label-area) {
    font-variant-numeric: tabular-nums;
  }
</style>
