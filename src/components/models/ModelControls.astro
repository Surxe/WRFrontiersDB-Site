---
// Build panel for the 3D model viewer. src/scripts/model_viewer renders the
// cascading part dropdowns into #model-builder (ui/builder.ts) and reads the
// view toggles by id. With Compare on, build B's dropdowns go into
// #model-builder-b (B = A plus the user's swaps; see robot/build/compare.ts).
import LocalizedText from '../LocalizedText.astro';
import { getDefaultString } from '../../utils/localization';
import type { ModelStrings } from '../../scripts/model_viewer/strings';

interface Props {
  strings: ModelStrings;
}

const { strings } = Astro.props;
---

<aside
  class="model-controls wrf-panel"
  aria-label={getDefaultString(strings.buildPanel)}
  data-model-aria-label="buildPanel"
>
  <div class="model-build-head">
    <LocalizedText
      tag="h2"
      id="model-build-a-title"
      localizationKey={strings.build}
    />
    <label class="model-check">
      <input type="checkbox" id="model-compare" />
      <LocalizedText tag="span" localizationKey={strings.compare} />
    </label>
  </div>
  <div id="model-builder" class="model-builder" aria-live="polite">
    <p class="model-placeholder">
      <LocalizedText tag="span" localizationKey={strings.loadingParts} />
    </p>
  </div>
  <section
    id="model-compare-b"
    class="model-compare-b"
    aria-labelledby="model-build-b-title"
    hidden
  >
    <div class="model-build-head">
      <LocalizedText
        tag="h2"
        id="model-build-b-title"
        localizationKey={strings.buildB}
      />
      <button
        type="button"
        id="model-compare-reset"
        class="wrf-btn wrf-btn--secondary wrf-btn--sm"
      >
        <LocalizedText tag="span" localizationKey={strings.resetB} />
      </button>
    </div>
    <p class="model-placeholder">
      <LocalizedText tag="span" localizationKey={strings.compareHint} />
    </p>
    <div id="model-builder-b" class="model-builder" aria-live="polite"></div>
  </section>
  <div class="model-view-toggles">
    <label class="model-check">
      <input type="checkbox" id="model-mesh" checked />
      <LocalizedText tag="span" localizationKey={strings.mesh} />
    </label>
    <label class="model-check">
      <input type="checkbox" id="model-hitbox" checked />
      <LocalizedText tag="span" localizationKey={strings.hitbox} />
    </label>
    <button
      type="button"
      id="model-clear"
      class="wrf-btn wrf-btn--secondary wrf-btn--sm model-clear"
      title={getDefaultString(strings.clearBuildTitle)}
      data-model-title="clearBuildTitle"
    >
      <LocalizedText tag="span" localizationKey={strings.clearBuild} />
    </button>
  </div>
</aside>

<style>
  .model-controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .model-controls :global(h2) {
    margin: 0;
    font-size: 1rem;
  }

  .model-build-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .model-compare-b {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--wrf-border);
  }

  .model-compare-b[hidden] {
    display: none;
  }

  .model-placeholder {
    margin: 0;
    color: var(--wrf-text-muted);
    font-size: 0.85rem;
  }

  .model-builder {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Rows are created at runtime by ui/builder.ts, hence :global. */
  .model-builder :global(.builder-row) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* A part's weapon slots sit one level in. */
  .model-builder :global(.builder-row.is-nested) {
    padding-left: 0.9rem;
  }

  .model-builder :global(.builder-row label) {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.85rem;
  }

  .model-builder :global(.model-hint) {
    font-size: 0.75rem;
  }

  /* Build B rows that differ from build A. */
  .model-builder :global(.builder-row.is-changed) {
    margin-left: -0.5rem;
    padding-left: 0.35rem;
    border-left: 3px solid var(--wrf-accent);
  }

  .model-builder :global(.builder-row.is-nested.is-changed) {
    padding-left: 1.25rem;
  }

  .model-builder :global(.builder-changed) {
    color: var(--wrf-accent);
    font-size: 0.75rem;
  }

  .model-builder :global(.builder-revert) {
    margin-left: auto;
    font-size: 0.75rem;
  }

  /* Part dropdowns: .wrf-select + .wrf-listbox (ui/part_picker.ts). */
  .model-builder :global(.model-picker) {
    position: relative;
  }

  .model-builder :global(.model-part) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 0.35rem;
    align-items: center;
  }

  .model-view-toggles {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--wrf-border);
  }

  .model-clear {
    margin-left: auto;
  }

  .model-check {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
  }
</style>
