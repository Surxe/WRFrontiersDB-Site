---
// Build panel for the 3D model viewer. src/scripts/model_viewer renders the
// cascading part dropdowns into #model-builder (build/ui.ts) and reads the
// view toggles by id. With Compare on, build B's dropdowns go into
// #model-builder-b (B = A plus the user's swaps; see build/compare.ts).
---

<aside class="model-controls" aria-label="Robot build">
  <div class="model-build-head">
    <h2 id="model-build-a-title">Build</h2>
    <label class="model-check">
      <input type="checkbox" id="model-compare" />
      Compare
    </label>
  </div>
  <div id="model-builder" class="model-builder" aria-live="polite">
    <p class="builder-placeholder">Loading parts...</p>
  </div>
  <section
    id="model-compare-b"
    class="model-compare-b"
    aria-labelledby="model-build-b-title"
    hidden
  >
    <div class="model-build-head">
      <h2 id="model-build-b-title">Build B</h2>
      <button type="button" id="model-compare-reset" class="model-small-button">
        Reset B
      </button>
    </div>
    <p class="builder-placeholder">
      Swap any parts to compare against build A. Slots you leave alone follow A.
    </p>
    <div id="model-builder-b" class="model-builder" aria-live="polite"></div>
  </section>
  <div class="model-view-toggles">
    <label class="model-check">
      <input type="checkbox" id="model-mesh" checked />
      Mesh
    </label>
    <label class="model-check">
      <input type="checkbox" id="model-hitbox" checked />
      Hitbox
    </label>
  </div>
</aside>

<style>
  .model-controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-md);
    background: var(--wrf-surface);
  }

  .model-controls h2 {
    margin: 0;
    font-size: 1rem;
  }

  .model-build-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .model-compare-b {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--wrf-border);
  }

  .model-compare-b[hidden] {
    display: none;
  }

  .model-small-button {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-sm);
    background: var(--wrf-surface-2);
    color: var(--wrf-text);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .model-small-button:hover {
    border-color: var(--wrf-accent-hover);
  }

  /* Build B rows that differ from build A (build/ui.ts). */
  .model-builder :global(.builder-row.is-changed) {
    margin-left: -0.5rem;
    padding-left: calc(var(--depth, 0) * 0.9rem + 0.35rem);
    border-left: 3px solid var(--wrf-accent);
  }

  .model-builder :global(.builder-changed) {
    color: var(--wrf-accent);
    font-size: 0.75rem;
  }

  .model-builder :global(.builder-revert) {
    margin-left: auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--wrf-link);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .model-builder :global(.builder-revert:hover) {
    color: var(--wrf-link-hover);
    text-decoration: underline;
  }

  .model-builder {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .builder-placeholder {
    margin: 0;
    color: var(--wrf-text-muted);
    font-size: 0.85rem;
  }

  /* Rows are created at runtime by build/ui.ts, hence :global. */
  .model-builder :global(.builder-row) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-left: calc(var(--depth, 0) * 0.9rem);
  }

  .model-builder :global(.builder-row label) {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.85rem;
  }

  .model-builder :global(.builder-hint) {
    color: var(--wrf-text-muted);
    font-size: 0.75rem;
  }

  /* Part dropdowns: a button + listbox (build/ui.ts), so options can show
     the part's ObjRef icon and localized name. */
  .model-builder :global(.part-picker) {
    position: relative;
  }

  .model-builder :global(.part-picker-button) {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 2rem;
    padding: 0.2rem 1.6rem 0.2rem 0.4rem;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-sm);
    background: var(--wrf-surface-2);
    color: var(--wrf-text);
    font: inherit;
    font-size: 0.85rem;
    text-align: left;
    cursor: pointer;
  }

  .model-builder :global(.part-picker-button::after) {
    content: '';
    position: absolute;
    right: 0.6rem;
    top: 50%;
    border: 0.3rem solid transparent;
    border-top-color: var(--wrf-text-muted);
    transform: translateY(-25%);
  }

  .model-builder :global(.part-picker-button:hover:not(:disabled)) {
    border-color: var(--wrf-accent-hover);
  }

  .model-builder :global(.part-picker-button:disabled) {
    cursor: default;
    opacity: 0.7;
  }

  .model-builder :global(.part-picker-list) {
    position: absolute;
    z-index: 20;
    top: calc(100% + 2px);
    left: 0;
    right: 0;
    max-height: 20rem;
    margin: 0;
    padding: 0.2rem 0;
    overflow-y: auto;
    list-style: none;
    border: 1px solid var(--wrf-border);
    border-radius: var(--wrf-radius-sm);
    background: var(--wrf-surface-2);
    box-shadow: 0 6px 18px rgb(0 0 0 / 35%);
  }

  .model-builder :global(.part-picker-list:focus) {
    outline: none;
  }

  .model-builder :global(.part-picker-option) {
    padding: 0.2rem 0.5rem;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .model-builder :global(.part-picker-option.is-active) {
    background: var(--wrf-accent-active-bg);
  }

  .model-builder :global(.part-picker-option[aria-selected='true']) {
    font-weight: bold;
  }

  .model-builder :global(.part-picker-group) {
    padding: 0.35rem 0.5rem 0.1rem;
    color: var(--wrf-text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .model-builder :global(.part-content) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 0.35rem;
    align-items: center;
  }

  .model-view-toggles {
    display: flex;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--wrf-border);
  }

  .model-check {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
  }
</style>
