---
export interface Props {
  maxLevel: number;
  initialLevel?: number;
}

const { maxLevel, initialLevel = 0 } = Astro.props;
---

<div class="level-switcher" style="margin-bottom: 1rem;">
  <div class="slider-group">
    <label for="level-switcher">
      Item Level: <span id="level-display">{initialLevel + 1}</span>
    </label>
    <input
      type="range"
      id="level-switcher"
      class="level-slider"
      min="0"
      max={maxLevel - 1}
      value={initialLevel}
    />
  </div>
</div>

<style>
  .slider-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .slider-group label {
    font-size: 0.95rem;
    color: var(--wrf-text);
    min-width: 100px;
  }

  .slider-group span {
    font-weight: bold;
    color: var(--wrf-accent);
  }

  .level-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 200px;
    height: 6px;
    background: var(--wrf-surface-2);
    border-radius: 4px;
    outline: none;
    cursor: pointer;
    transition: background 0.3s;
  }

  .level-slider:hover {
    background: var(--wrf-border);
  }

  .level-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--wrf-accent);
    cursor: pointer;
    box-shadow:
      0 2px 5px rgba(0, 0, 0, 0.3),
      0 0 5px rgba(79, 195, 247, 0.4);
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  .level-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
    background: #73d5ff;
  }

  .level-slider::-webkit-slider-thumb:active {
    transform: scale(0.95);
    background: var(--wrf-accent-hover);
  }

  .level-slider::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: none;
    border-radius: 50%;
    background: var(--wrf-accent);
    cursor: pointer;
    box-shadow:
      0 2px 5px rgba(0, 0, 0, 0.3),
      0 0 5px rgba(79, 195, 247, 0.4);
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  .level-slider::-moz-range-thumb:hover {
    transform: scale(1.2);
    background: #73d5ff;
  }

  .level-slider::-moz-range-thumb:active {
    transform: scale(0.95);
    background: var(--wrf-accent-hover);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const levelSwitcher = document.getElementById('level-switcher');
    const levelDisplay = document.getElementById('level-display');

    if (levelSwitcher && levelDisplay) {
      levelSwitcher.addEventListener('input', (e) => {
        levelDisplay.textContent = parseInt(e.target.value, 10) + 1;
      });
    }
  });
</script>
