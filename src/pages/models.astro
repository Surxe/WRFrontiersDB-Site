---
import Page from '../components/Page.astro';
---

<Page title="3D Models" description="Live hitbox + untextured model construction for War Robots: Frontiers loadouts.">
  <main class="model-page">
    <header class="model-header">
      <h1>3D Models</h1>
      <p>
        Live-constructed hitbox + untextured models. Pick a bot preset and a
        shoulder: weapon sockets fill with a Punisher (light slot) or Hefty
        (heavy slot) automatically, or force one weapon type.
      </p>
    </header>

    <section class="model-controls" aria-label="Model controls">
      <label>
        Bot
        <select id="model-bot"></select>
      </label>
      <label>
        Preset
        <select id="model-preset"></select>
      </label>
      <label>
        Shoulder
        <select id="model-side">
          <option value="Both">Both</option>
          <option value="L">Left</option>
          <option value="R">Right</option>
        </select>
      </label>
      <label>
        Weapon
        <select id="model-weapon">
          <option value="auto">Auto (light: Punisher, heavy: Hefty)</option>
          <option value="punisher">Punisher</option>
          <option value="hefty">Hefty</option>
        </select>
      </label>
      <label class="model-check">
        <input type="checkbox" id="model-hitbox" checked />
        Hitbox
      </label>
      <label class="model-check">
        <input type="checkbox" id="model-skeleton" />
        Skeleton
      </label>
    </section>

    <div id="model-canvas" class="model-canvas" role="img" aria-label="3D model viewer">
      <div id="model-loading" class="model-canvas-loading">Loading viewer...</div>
    </div>
    <div id="model-status" class="model-status">Initializing...</div>

    <section class="model-notes">
      <h2>Notes</h2>
      <ul>
        <li>Units are Unreal centimeters (X forward, Y right, Z up); the scene is shown with Z-up.</li>
        <li>Drag to orbit, scroll to zoom, right-drag to pan.</li>
        <li>
          Weapon placement uses the preset socket chain plus the runtime mount
          rotation applied by the game (see the WRFrontiersDB-Models repo).
        </li>
      </ul>
    </section>
  </main>
</Page>

<script>
  import '../scripts/model_viewer.ts';
</script>

<style>
  .model-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
  }

  .model-header h1 {
    margin: 0 0 0.25rem;
  }

  .model-header p {
    margin: 0 0 1rem;
    opacity: 0.85;
  }

  .model-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .model-controls label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.85rem;
  }

  .model-controls select,
  .model-controls input[type='checkbox'] {
    padding: 0.3rem;
  }

  .model-check {
    flex-direction: row !important;
    align-items: center;
    gap: 0.35rem !important;
  }

  .model-canvas {
    position: relative;
    width: 100%;
    height: 640px;
    border-radius: 8px;
    overflow: hidden;
    background: #14161a;
  }

  .model-canvas canvas {
    display: block;
  }

  .model-canvas-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9aa0a6;
  }

  .model-status {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #9aa0a6;
    min-height: 1.2em;
  }

  .model-notes {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  .model-notes ul {
    padding-left: 1.2rem;
  }
</style>
