---
import Page from '../components/Page.astro';
import ModelControls from '../components/models/ModelControls.astro';
import ModelViewport from '../components/models/ModelViewport.astro';
import ModelNotes from '../components/models/ModelNotes.astro';
---

<Page title="3D Models" description="Live hitbox + untextured model construction for War Robots: Frontiers loadouts.">
  <main class="model-page">
    <header class="model-header">
      <h1>3D Models</h1>
      <p>
        Live-constructed hitbox + untextured models. Pick a bot preset and a
        shoulder to render its real modules and equipped weapons. Your current
        view is always reflected in the URL, so you can copy it to share an
        exact loadout.
      </p>
    </header>

    <ModelControls />
    <ModelViewport />
    <ModelNotes />
  </main>
</Page>

<script>
  import '../scripts/model_viewer/index.ts';
</script>

<style>
  .model-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
  }

  .model-header h1 {
    margin: 0 0 0.25rem;
  }

  .model-header p {
    margin: 0 0 1rem;
    opacity: 0.85;
  }
</style>
