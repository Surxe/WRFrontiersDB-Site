---
import Page from '../components/Page.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getModelsBreadcrumbs } from '../utils/breadcrumb';
import ModelControls from '../components/models/ModelControls.astro';
import ModelViewport from '../components/models/ModelViewport.astro';
import HitboxAreaPanel from '../components/models/HitboxAreaPanel.astro';
import ModelPartRefs from '../components/models/ModelPartRefs.astro';
---

<Page
  title="3D Models"
  description="Build any War Robots: Frontiers robot part by part and view its live hitbox + untextured model."
>
  <main class="model-page">
    <Breadcrumb breadcrumbs={getModelsBreadcrumbs()} />
    <header class="model-header">
      <h1>3D Models</h1>
      <p>
        Build any robot part by part: pick a chassis, then its torso, each
        shoulder, and a weapon for every mount slot. Each part's slots appear
        once the part is placed, just like in the hangar. Your build is always
        reflected in the URL, so you can copy it to share an exact loadout.
      </p>
      <p class="model-hint">
        Drag to orbit, right-drag to pan, scroll to zoom.
      </p>
    </header>

    <div class="model-layout">
      <ModelControls />
      <div class="model-stage">
        <ModelViewport />
        <HitboxAreaPanel />
      </div>
    </div>
    <ModelPartRefs />
  </main>
</Page>

<script>
  import '../scripts/model_viewer/index.ts';
</script>

<style>
  .model-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem;
  }

  .model-header h1 {
    margin: 0 0 0.25rem;
  }

  .model-header p {
    margin: 0 0 1rem;
    opacity: 0.85;
  }

  .model-header .model-hint {
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .model-layout {
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .model-stage {
    min-width: 0;
  }

  @media (max-width: 800px) {
    .model-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
