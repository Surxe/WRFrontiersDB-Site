---
/**
 * Shoulder Profiles page
 * Statically generated at build time from Analysis/shoulder_profiles.json.
 *
 * For each category (unique weight_drain × light_slots × heavy_slots),
 * renders:
 *   - One shield-recharge graph per shoulder (via ShoulderGraph)
 *   - One stats table covering all shoulders in the category (via ShoulderStatsTable)
 *
 * A shared LevelSwitcher updates all graphs and table highlights simultaneously.
 */
import * as fs from 'fs';
import * as path from 'path';
import Page from '../../components/Page.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LevelSwitcher from '../../components/LevelSwitcher.astro';
import CategoryChart from '../../components/shoulder_profiles/CategoryChart.astro';
import ShoulderStatsTable from '../../components/shoulder_profiles/ShoulderStatsTable.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import type { ShoulderCategory } from '../../types/shoulder_profile';
import type { Module } from '../../types/module';
import type { LocalizationKey } from '../../types/localization';
import { getParseObjects } from '../../utils/parse_object';
import { getShoulderProfilesBreadcrumbs } from '../../utils/breadcrumb';

// ---------------------------------------------------------------------------
// Load data
// ---------------------------------------------------------------------------

const profilesPath = path.join(
  process.cwd(),
  'WRFrontiersDB-Data/current/Analysis/shoulder_profiles.json'
);
const categories: ShoulderCategory[] = JSON.parse(
  fs.readFileSync(profilesPath, 'utf-8')
);

// Sort the categories by Weight, Light Slots, then Heavy Slots
categories.sort((a, b) => {
  if (a.weight_drain !== b.weight_drain) {
    return a.weight_drain - b.weight_drain;
  }
  if (a.light_slots !== b.light_slots) {
    return a.light_slots - b.light_slots;
  }
  return a.heavy_slots - b.heavy_slots;
});

// Build moduleId → LocalizationKey map from Module.json
const allModules = getParseObjects<Module>('Objects/Module.json');
const moduleNameMap: Record<string, LocalizationKey> = {};
for (const [id, module] of Object.entries(allModules)) {
  if (module.name) {
    moduleNameMap[id] = module.name as LocalizationKey;
  }
}

// ---------------------------------------------------------------------------
// Per-category derived values for shared axis scales
// ---------------------------------------------------------------------------

interface CategoryDerivedData {
  maxTime: number;
  maxShield: number;
  label: string;
}

function deriveCategoryData(category: ShoulderCategory): CategoryDerivedData {
  let maxTime = 0;
  let maxShield = 0;
  for (const shoulder of category.shoulders) {
    for (const stats of Object.values(shoulder.levels)) {
      if (stats.DelayAndRechargeTotal > maxTime)
        maxTime = stats.DelayAndRechargeTotal;
      if (stats.ShieldAmount > maxShield) maxShield = stats.ShieldAmount;
    }
  }

  const lightPart =
    category.light_slots > 0 ? `Light ×${category.light_slots}` : null;
  const heavyPart =
    category.heavy_slots > 0 ? `Heavy ×${category.heavy_slots}` : null;
  const slotParts =
    [lightPart, heavyPart].filter(Boolean).join(', ') || 'No Slots';
  const label = `${slotParts} — Weight ${category.weight_drain}`;

  return { maxTime, maxShield, label };
}

const MAX_LEVEL = 13;
const INITIAL_LEVEL_INDEX = MAX_LEVEL - 1; // 0-indexed → level 13
---

<Page
  title="Shoulder Profiles"
  description="Shield recharge comparison charts and stat tables for all shoulder module categories in War Robots Frontiers."
>
  <main class="shoulder-profiles-page">
    <Breadcrumb breadcrumbs={getShoulderProfilesBreadcrumbs()} />
    <h1>Shoulder Profiles</h1>
    <p class="page-description">
      Shield recharge curves and stats for each shoulder category. Shields start
      broken; the graph shows how shields recover over time. Use the level
      selector to compare at different upgrade levels.
      Shoulder hitboxes have unique shapes and sizes that are not able to be represented by the following stats and curves.
    </p>

    <div class="level-switcher-sticky">
      <LevelSwitcher maxLevel={MAX_LEVEL} initialLevel={INITIAL_LEVEL_INDEX} />
    </div>

    <div class="page-layout">
      <div class="content-col">
        {
          categories.map((category, catIdx) => {
            const { maxTime, maxShield, label } = deriveCategoryData(category);

            return (
              <section
                class="shoulder-category-section"
                data-category-idx={catIdx}
              >
                <h2 class="category-heading">{label}</h2>

                {/* Graphs row */}
                <div class="category-graph-row">
                  <CategoryChart
                    shoulders={category.shoulders}
                    moduleNameMap={moduleNameMap}
                    categoryMaxTime={maxTime}
                    categoryMaxShield={maxShield}
                    graphId={`graph-${catIdx}`}
                  />
                </div>

                {/* Stats table */}
                <ShoulderStatsTable
                  shoulders={category.shoulders}
                  moduleNameMap={moduleNameMap}
                  tableId={`table-${catIdx}`}
                />
              </section>
            );
          })
        }
      </div>

      <div class="sidebar-col">
        <TableOfContents selector=".category-heading" title="Categories" />
      </div>
    </div>
  </main>

  {/* Localization + chart initialization */}
  <script type="module">
    import { initializeLocalization } from '/js/localization.js';
    initializeLocalization('current');
  </script>
  <script is:inline src="/js/shoulder_profiles.js"></script>
</Page>

<style>
  .shoulder-profiles-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .page-description {
    color: #aaa;
    margin-bottom: 1.5rem;
    max-width: 70ch;
  }

  .level-switcher-sticky {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #1a1a1a;
    padding: 0.5rem 0;
    border-bottom: 1px solid #333;
    margin-bottom: 2rem;
  }

  .page-layout {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .content-col {
    flex: 1;
    min-width: 0; /* Prevents flex items from blowing out their container */
  }

  .sidebar-col {
    width: 250px;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .page-layout {
      flex-direction: column;
    }
    .sidebar-col {
      width: 100%;
      order: -1; /* Move TOC above content on mobile */
      margin-bottom: 2rem;
    }
  }

  .shoulder-category-section {
    margin-bottom: 3.5rem;
  }

  .category-heading {
    border-bottom: 2px solid #4fc3f7;
    padding-bottom: 0.4rem;
    margin-bottom: 1.5rem;
    color: #4fc3f7;
  }

  .category-graph-row {
    margin-bottom: 2rem;
  }

  /* ---- ShoulderStatsTable ---- */
  :global(.shoulder-stats-table-wrapper) {
    border-radius: 6px;
    border: 1px solid #383838;
  }

  :global(.shoulder-stats-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  :global(.shoulder-stats-table th:first-child) {
    border-top-left-radius: 5px;
  }
  :global(.shoulder-stats-table th:last-child) {
    border-top-right-radius: 5px;
  }

  :global(.shoulder-stats-table th) {
    background: #2e2e2e;
    color: #ccc;
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    text-align: right;
    font-weight: 600;
  }

  :global(.shoulder-stats-table th:first-child),
  :global(.shoulder-stats-table th:nth-child(2)) {
    text-align: left;
  }

  :global(.shoulder-stats-table td) {
    padding: 0.4rem 0.75rem;
    border-top: 1px solid #2e2e2e;
    color: #ddd;
    text-align: right;
  }

  :global(.shoulder-stats-table .shoulder-name-cell) {
    text-align: left;
    font-weight: 600;
    color: #e8e8e8;
    background: #252525;
    border-right: 1px solid #383838;
    min-width: 110px;
    vertical-align: top;
  }

  :global(.shoulder-stats-table .level-cell) {
    text-align: center;
    color: #aaa;
    min-width: 50px;
  }

  /* Hide all data rows by default */
  :global(.shoulder-stats-table tr[data-level]) {
    display: none;
  }

  /* Only display the rows matching the currently selected level */
  :global(.shoulder-stats-table tr.is-active-level) {
    display: table-row;
  }

  /* ---- Tooltips ---- */
  :global(.th-content) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  /* Reset the first two columns to left-align */
  :global(.shoulder-stats-table th:first-child .th-content),
  :global(.shoulder-stats-table th:nth-child(2) .th-content) {
    justify-content: flex-start;
  }

  :global(.stat-tooltip-container) {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: help;
  }

  :global(.stat-help-icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: #4fc3f7;
    color: #121212;
    font-size: 10px;
    font-weight: bold;
    line-height: 1;
  }

  :global(.stat-tooltip-text) {
    visibility: hidden;
    opacity: 0;
    width: 220px;
    background-color: #333;
    color: #fff;
    text-align: left;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    position: absolute;
    z-index: 100;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
    transition:
      opacity 0.2s,
      visibility 0.2s;
    font-size: 0.8rem;
    font-weight: normal;
    white-space: normal;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    pointer-events: none;
  }

  :global(.stat-tooltip-text::after) {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -5px;
    border-width: 5px;
    border-style: solid;
    border-color: #333 transparent transparent transparent;
  }

  :global(.stat-tooltip-container:hover .stat-tooltip-text) {
    visibility: visible;
    opacity: 1;
  }
</style>
